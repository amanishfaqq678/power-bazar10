# Supabase configuration required by the app and Vercel deployment
# Copy these values from your Supabase project settings and set them in Vercel.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Server-side/admin values (used for Supabase server helpers only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-key>
